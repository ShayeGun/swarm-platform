# =====================================================================
# Swarm Platform - Root Environment Example
# Copy to .env and fill values. Load with: set -a; . .env; set +a
# =====================================================================

# ---------------------------------------------------------------------
# Cluster / domain
# ---------------------------------------------------------------------
DOMAIN=example.com
DATA_PATH=/data
TZ=UTC

# Node labels (assign after joining nodes):
#   docker node update --label-add server=manager <manager-node>
#   docker node update --label-add server=gitlab <gitlab-node>
#   docker node update --label-add server=jira <jira-node>
#   docker node update --label-add server=keycloak <keycloak-node>
#   docker node update --label-add server=mattermost <mattermost-node>
#   docker node update --label-add server=monitoring <monitoring-node>
#   docker node update --label-add server=object-storage <object-storage-node>

# ---------------------------------------------------------------------
# Traefik
# ---------------------------------------------------------------------
TRAEFIK_IMAGE=traefik:v3.6.2
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------
# Shared PostgreSQL (single instance, multiple databases)
# ---------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17.6-alpine
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=platform
POSTGRES_DATA_PATH=/data/postgres

# Per-service databases/users (created via init scripts)
JIRA_DB=jira
JIRA_DB_USER=jira
JIRA_DB_PASSWORD=change-me
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
MATTERMOST_DB=mattermost
MATTERMOST_DB_USER=mattermost
MATTERMOST_DB_PASSWORD=change-me

# ---------------------------------------------------------------------
# Shared Redis
# ---------------------------------------------------------------------
REDIS_IMAGE=redis:8.0.2-alpine
REDIS_DATA_PATH=/data/redis
REDIS_PASSWORD=change-me

# ---------------------------------------------------------------------
# GitLab (keeps its own internal reverse proxy)
# ---------------------------------------------------------------------
GITLAB_IMAGE=gitlab/gitlab-ce:17.11.3-ce.0
GITLAB_HOSTNAME=git.example.com
GITLAB_DATA_PATH=/srv/gitlab

# ---------------------------------------------------------------------
# Jira
# ---------------------------------------------------------------------
JIRA_IMAGE=atlassian/jira-software:9.12.0
JIRA_DATA_PATH=/data/jira

# ---------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------
KEYCLOAK_IMAGE=rsa-kc:26.7.3
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_HOST=postgres
CERTS_PATH=/data/keycloak/certs

# ---------------------------------------------------------------------
# Mattermost
# ---------------------------------------------------------------------
MATTERMOST_IMAGE=mattermost/mattermost-enterprise-edition:10.5.2
POSTGRES_IMAGE_TAG=17.6-alpine
RESTART_POLICY=unless-stopped
MATTERMOST_CONFIG_PATH=/data/mattermost/config
MATTERMOST_DATA_PATH=/data/mattermost/data
MATTERMOST_LOGS_PATH=/data/mattermost/logs
MATTERMOST_PLUGINS_PATH=/data/mattermost/plugins
MATTERMOST_CLIENT_PLUGINS_PATH=/data/mattermost/client/plugins
MATTERMOST_BLEVE_INDEXES_PATH=/data/mattermost/bleve-indexes
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://${MATTERMOST_DB_USER}:${MATTERMOST_DB_PASSWORD}@postgres:5432/${MATTERMOST_DB}?sslmode=disable&connect_timeout=10
MM_SERVICESETTINGS_SITEURL=https://mm.${DOMAIN}
MM_BLEVESETTINGS_INDEXDIR=/mattermost/bleve-indexes
MATTERMOST_CONTAINER_READONLY=false
APP_PORT=8065
HTTPS_PORT=443
HTTP_PORT=80
CALLS_PORT=8443

# ---------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong
NEXUS_IMAGE=sonatype/nexus3:3.95.3-alpine
NEXUS_DATA_PATH=/data/nexus
MINIO_DATA_PATH=/data/minio

# ---------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------
FALCO_IMAGE=falcosecurity/falco:0.45.0
FALCOSIDEKICK_IMAGE=falcosecurity/falcosidekick:2.35.0
FALCOSIDEKICK_UI_IMAGE=falcosecurity/falcosidekick-ui:2.3.1
GRAFANA_IMAGE=grafana/grafana:12.4.0
LOKI_IMAGE=grafana/loki:3.7.1
MIMIR_IMAGE=grafana/mimir:3.0.5
ALLOY_IMAGE=grafana/alloy:v1.15.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
